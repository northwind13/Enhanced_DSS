        <mxCell id="SJcJ09xJZXgUBLT_JLGA-1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F3864;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;arcSize=10;" value="RESEARCH QUESTION" vertex="1">
          <mxGeometry height="24" width="720" x="230" y="70" as="geometry" />
        </mxCell>
        <mxCell id="SJcJ09xJZXgUBLT_JLGA-2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9E2F3;strokeColor=#1F3864;fontSize=11;fontStyle=2;arcSize=10;align=left;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;" value="Can a wildfire DSS simultaneously achieve:&#xa;&#8226; adaptive guidance over an open decision space &#8226; non-probabilistic uncertainty &#8226; rule-level interpretability&#xa;&#8226; formal correctness guarantees &#8211; all under partial observability and distributed real-time constraints?" vertex="1">
          <mxGeometry height="80" width="720" x="230" y="94" as="geometry" />
        </mxCell>
        <mxCell id="SJcJ09xJZXgUBLT_JLGA-3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#375623;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;arcSize=10;" value="MAIN HYPOTHESIS" vertex="1">
          <mxGeometry height="24" width="720" x="230" y="194" as="geometry" />
        </mxCell>
        <mxCell id="SJcJ09xJZXgUBLT_JLGA-4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#375623;fontSize=11;fontStyle=2;arcSize=10;align=left;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;" value="A hierarchically distributed DSS with concept-driven fuzzy reasoning, non-inferential global coordination, confidence-gated uncertainty encoding, and a satisficing acceptance mechanism resolves all three structural gaps and admits formal proof of its pipeline correctness properties." vertex="1">
          <mxGeometry height="70" width="720" x="230" y="218" as="geometry" />
        </mxCell>
        <mxCell id="SJcJ09xJZXgUBLT_JLGA-5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E75B6;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;arcSize=8;" value="H1  Scalability &amp; Adaptability" vertex="1">
          <mxGeometry height="30" width="230" x="230" y="322" as="geometry" />
        </mxCell>
        <mxCell id="SJcJ09xJZXgUBLT_JLGA-6" parent="1" style="whiteSpace=wrap;html=1;fillColor=#DEEBF7;strokeColor=#2E75B6;fontSize=9;align=center;spacingTop=4;spacingBottom=4;" value="Adaptive interventions at lower rule-base&#xa;complexity and faster response than&#xa;centralized DSS" vertex="1">
