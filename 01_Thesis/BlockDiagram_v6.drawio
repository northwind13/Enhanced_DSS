        </mxCell>
        <mxCell id="ebRH9_izZCovWzlnWHGh-10" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C0392B;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" value="The offensive orders are withheld this cycle.&#xa;No capacity is fielded and no response cost is paid,&#xa;while the life-safety orders (evacuation and public warning) still stand." vertex="1">
