  <diagram id="qt2IZAeR1lNbQifEYP91" name="Figure 2.4 Mamdani and zero-order Takagi-Sugeno inference pipelines">
    <mxGraphModel dx="1062" dy="621" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="E8b3zKsDOOf9UvkKCUfk-1" parent="1" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#7a2828;align=left;verticalAlign=top;" value="Mamdani inference" vertex="1">
          <mxGeometry height="40" width="760" x="80" y="196" as="geometry" />
        </mxCell>
        <mxCell id="E8b3zKsDOOf9UvkKCUfk-2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;" value="Fuzzification&#xa;\(\mu_{A_{r,n}}(x_n)\)" vertex="1">
          <mxGeometry height="90" width="100" x="80" y="236" as="geometry" />
        </mxCell>
        <mxCell id="E8b3zKsDOOf9UvkKCUfk-3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;" value="Rule activation&#xa;\(w_r=\min_{n}\ \mu_{A_{r,n}}(x_n)\)" vertex="1">
          <mxGeometry height="90" width="150" x="210" y="236" as="geometry" />
        </mxCell>
        <mxCell id="E8b3zKsDOOf9UvkKCUfk-4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;" value="Consequent sets (clip)&#xa;\(\mu&#39;_{B_r}(y)=\min\{w_r,\ \mu_{B_r}(y)\}\)" vertex="1">
          <mxGeometry height="90" width="170" x="400" y="236" as="geometry" />
        </mxCell>
        <mxCell id="E8b3zKsDOOf9UvkKCUfk-5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;" value="Aggregation (max)&#xa;\(\mu_{agg}(y)=\max_r\ \mu&#39;_{B_r}(y)\)" vertex="1">
          <mxGeometry height="90" width="160" x="600" y="236" as="geometry" />
        </mxCell>
        <mxCell id="E8b3zKsDOOf9UvkKCUfk-6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" value="Defuzzification (centroid)&#xa;\(u=\frac{\int y\,\mu_{agg}(y)\,dy}{\int \mu_{agg}(y)\,dy}\)" vertex="1">
          <mxGeometry height="90" width="130" x="790" y="236" as="geometry" />
        </mxCell>
        <mxCell id="E8b3zKsDOOf9UvkKCUfk-7" edge="1" parent="1" source="E8b3zKsDOOf9UvkKCUfk-2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" target="E8b3zKsDOOf9UvkKCUfk-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="E8b3zKsDOOf9UvkKCUfk-8" edge="1" parent="1" source="E8b3zKsDOOf9UvkKCUfk-3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" target="E8b3zKsDOOf9UvkKCUfk-4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="E8b3zKsDOOf9UvkKCUfk-9" edge="1" parent="1" source="E8b3zKsDOOf9UvkKCUfk-4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" target="E8b3zKsDOOf9UvkKCUfk-5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="E8b3zKsDOOf9UvkKCUfk-10" edge="1" parent="1" source="E8b3zKsDOOf9UvkKCUfk-5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" target="E8b3zKsDOOf9UvkKCUfk-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="E8b3zKsDOOf9UvkKCUfk-11" parent="1" style="text;html=1;fontSize=12;fontStyle=0;fontColor=#7a2828;align=left;verticalAlign=top;" value="Output is a fuzzy SET; per-decision centroid integration; plateaued output surface; adaptation acts on membership geometry only." vertex="1">
          <mxGeometry height="40" width="840" x="80" y="330" as="geometry" />
        </mxCell>
        <mxCell id="E8b3zKsDOOf9UvkKCUfk-12" parent="1" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#1e5a32;align=left;verticalAlign=top;" value="Takagi-Sugeno inference (zero-order)" vertex="1">
          <mxGeometry height="40" width="760" x="80" y="360" as="geometry" />
        </mxCell>
        <mxCell id="E8b3zKsDOOf9UvkKCUfk-13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;" value="Fuzzification&#xa;\(\mu_{A_{r,n}}(x_n)\)" vertex="1">
          <mxGeometry height="90" width="100" x="80" y="400" as="geometry" />
        </mxCell>
        <mxCell id="E8b3zKsDOOf9UvkKCUfk-14" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;" value="Rule activation&#xa;\(w_r=\min_{n}\ \mu_{A_{r,n}}(x_n)\)" vertex="1">
          <mxGeometry height="90" width="150" x="210" y="400" as="geometry" />
        </mxCell>
        <mxCell id="E8b3zKsDOOf9UvkKCUfk-15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" value="Consequent values (singletons)&#xa;\(v_{r,m}\in[0,1]\)" vertex="1">
          <mxGeometry height="90" width="170" x="400" y="400" as="geometry" />
        </mxCell>
        <mxCell id="E8b3zKsDOOf9UvkKCUfk-16" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" value="Weighted average (closed form)&#xa;\(u_m=\frac{\sum_r w_r\,v_{r,m}}{\max(1,\ \sum_r w_r)}\)" vertex="1">
          <mxGeometry height="90" width="150" x="600" y="400" as="geometry" />
        </mxCell>
        <mxCell id="E8b3zKsDOOf9UvkKCUfk-17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;" value="\(u_m \rightarrow U_{DSS,k}^{i}\)" vertex="1">
          <mxGeometry height="90" width="120" x="795" y="400" as="geometry" />
        </mxCell>
        <mxCell id="E8b3zKsDOOf9UvkKCUfk-18" edge="1" parent="1" source="E8b3zKsDOOf9UvkKCUfk-13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" target="E8b3zKsDOOf9UvkKCUfk-14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="E8b3zKsDOOf9UvkKCUfk-19" edge="1" parent="1" source="E8b3zKsDOOf9UvkKCUfk-14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" target="E8b3zKsDOOf9UvkKCUfk-15">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="E8b3zKsDOOf9UvkKCUfk-20" edge="1" parent="1" source="E8b3zKsDOOf9UvkKCUfk-15" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" target="E8b3zKsDOOf9UvkKCUfk-16">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="E8b3zKsDOOf9UvkKCUfk-21" edge="1" parent="1" source="E8b3zKsDOOf9UvkKCUfk-16" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" target="E8b3zKsDOOf9UvkKCUfk-17">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="E8b3zKsDOOf9UvkKCUfk-22" parent="1" style="text;html=1;fontSize=12;fontStyle=0;fontColor=#1e5a32;align=left;verticalAlign=top;whiteSpace=wrap;" value="Crisp output by construction; one multiply-add per rule inside shadow rollouts; smooth interpolation between rule actions; consequents are auditable numbers that adaptation can nudge and gates can verify." vertex="1">
          <mxGeometry height="40" width="840" x="80" y="500" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
