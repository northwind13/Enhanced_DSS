          <mxGeometry height="96" width="460" x="229" y="219" as="geometry" />
        </mxCell>
        <mxCell id="ebRH9_izZCovWzlnWHGh-7" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF0FA;strokeColor=#4472C4;fontSize=12;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;" value="The regional candidates are merged into one composed allocation." vertex="1">
          <mxGeometry height="60" width="360" x="279" y="350" as="geometry" />
        </mxCell>
        <mxCell id="ebRH9_izZCovWzlnWHGh-8" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FDF3EC;strokeColor=#C65911;fontSize=12;align=center;verticalAlign=middle;" value="No-harm guard.&lt;br&gt;Forecast \(\tau_{horizon}\) ahead:&lt;br&gt;Is the outcome worse than taking no action?" vertex="1">
          <mxGeometry height="120" width="230" x="344" y="450" as="geometry" />
        </mxCell>
        <mxCell id="ebRH9_izZCovWzlnWHGh-9" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF6EE;strokeColor=#2E7D32;fontSize=12;align=center;verticalAlign=middle;" value="The composed plan is applied." vertex="1">
