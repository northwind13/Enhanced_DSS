        <mxCell id="D066kyzz_8KezAGM8SY4-37" edge="1" parent="1" source="D066kyzz_8KezAGM8SY4-30" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;strokeWidth=1.3;fontSize=10;fontColor=#1F4E79;" target="D066kyzz_8KezAGM8SY4-31" value="shares scale the candidates">
