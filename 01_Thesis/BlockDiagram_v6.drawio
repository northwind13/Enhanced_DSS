          <mxGeometry height="60" width="220" x="179" y="85" as="geometry" />
        </mxCell>
        <mxCell id="ebRH9_izZCovWzlnWHGh-4" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF0FA;strokeColor=#4472C4;fontSize=12;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;" value="Local DSS N forms the candidate \(U_{DSS,k}^{N}\) for its region" vertex="1">
