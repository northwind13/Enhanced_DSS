  <diagram name="Figure 4.8 Generative proposal and the verification gates" id="F48gatesCLR">
    <mxGraphModel dx="-940" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="680" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="8fn3158Nofi3qeclke3r-77" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" value="&lt;span&gt;Cycle chronicle&lt;/span&gt;&lt;br&gt;&lt;span&gt;records every closed cycle: its situation, proposal, gate verdict, and realized \(\Delta\hat{J}_{phys}\)&lt;/span&gt;" vertex="1">
          <mxGeometry height="54" width="439" x="2985" y="10" as="geometry" />
        </mxCell>
        <mxCell id="8fn3158Nofi3qeclke3r-79" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#1F6FB2;fillColor=#FFFFFF;fontSize=14;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" value="&lt;span&gt;LLM&amp;nbsp;&lt;/span&gt;&lt;span&gt;prompted in context; no weight update&lt;br&gt;&lt;br&gt;based on&amp;nbsp;&lt;/span&gt;the crisp decision concepts, the active rule base, and the coverage verdict" vertex="1">
          <mxGeometry height="120" width="191" x="2777" y="92.5" as="geometry" />
        </mxCell>
        <mxCell id="8fn3158Nofi3qeclke3r-81" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#d6b656;fillColor=#fff2cc;fontSize=14;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" value="&lt;span&gt;&lt;b&gt;Proposal&lt;/b&gt;&lt;/span&gt;&lt;br&gt;one rule or&lt;div&gt;a package&lt;br&gt;&lt;span&gt;(one rule + one new object)&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="79" width="220" x="3050" y="113" as="geometry" />
        </mxCell>
        <mxCell id="8fn3158Nofi3qeclke3r-82" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" value="&lt;span&gt;&lt;b&gt;Intermediate concept&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span&gt;a normalized composition of \(\le 4\) existing features or concepts&lt;/span&gt;" vertex="1">
          <mxGeometry height="54" width="240" x="2879" y="245" as="geometry" />
        </mxCell>
        <mxCell id="8fn3158Nofi3qeclke3r-83" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" value="&lt;span&gt;&lt;b&gt;Macro intervention \(\Phi_m\)&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span&gt;a named composition of \(\le 3\) base channels&lt;/span&gt;" vertex="1">
          <mxGeometry height="54" width="240" x="3193" y="245" as="geometry" />
        </mxCell>
        <mxCell id="8fn3158Nofi3qeclke3r-84" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" value="&lt;span&gt;&lt;b&gt;G1 Format: &lt;/b&gt;the antecedent and the consequent are well formed&lt;/span&gt;" vertex="1">
          <mxGeometry height="50" width="350" x="2970" y="380" as="geometry" />
        </mxCell>
        <mxCell id="8fn3158Nofi3qeclke3r-85" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" value="&lt;span&gt;&lt;b&gt;G2 Constraints: &lt;/b&gt;vocabulary, arity, numeric range, and no duplicate combination&lt;/span&gt;" vertex="1">
          <mxGeometry height="50" width="350" x="2970" y="459" as="geometry" />
        </mxCell>
        <mxCell id="8fn3158Nofi3qeclke3r-86" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" value="&lt;span&gt;&lt;b&gt;G2b Non-redundancy (Packages only):&amp;nbsp;&lt;/b&gt;The new concept is not redundant: \(\cos(\omega_{new},\omega_c)\lt 0.95\) for all \(c\)&lt;/span&gt;" vertex="1">
          <mxGeometry height="50" width="350" x="2970" y="543" as="geometry" />
        </mxCell>
        <mxCell id="8fn3158Nofi3qeclke3r-87" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" value="&lt;span&gt;&lt;b&gt;G3 (First seed gain): &lt;/b&gt;the forecast physical cost falls, \(\Delta\hat{J}_{phys}\le 0\)&lt;/span&gt;" vertex="1">
          <mxGeometry height="50" width="350" x="2970" y="626" as="geometry" />
        </mxCell>
        <mxCell id="8fn3158Nofi3qeclke3r-88" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" value="&lt;span&gt;&lt;b&gt;G4 (Robustness):&lt;/b&gt; the same check holds under a different seed&lt;/span&gt;" vertex="1">
          <mxGeometry height="50" width="350" x="2970" y="710" as="geometry" />
        </mxCell>
        <mxCell id="8fn3158Nofi3qeclke3r-89" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" value="&lt;span&gt;&lt;b&gt;G5 Voabulary payoff (Packages only):&lt;/b&gt;&amp;nbsp;Growth must pay: both rollouts beat the margin \(\delta_v\)&lt;/span&gt;" vertex="1">
          <mxGeometry height="50" width="350" x="2970" y="793" as="geometry" />
        </mxCell>
        <mxCell id="8fn3158Nofi3qeclke3r-90" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#b85450;fillColor=#f8cecc;fontSize=14;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" value="&lt;span&gt;&lt;b&gt;Rejected&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span&gt;The failing gate is recorded in the chronicle, and the cycle falls back to the fail-safe.&lt;/span&gt;" vertex="1">
          <mxGeometry height="129" width="129" x="3383" y="380" as="geometry" />
        </mxCell>
        <mxCell id="8fn3158Nofi3qeclke3r-91" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#82b366;fillColor=#d5e8d4;fontSize=14;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" value="&lt;span&gt;&lt;b&gt;Admitted&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span&gt;The rule enters the runtime rule base and the lineage store. An admitted object is charged to the controller reward.&lt;/span&gt;" vertex="1">
