        </mxCell>
        <mxCell id="SJcJ09xJZXgUBLT_JLGA-7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C65911;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;arcSize=8;" value="H2  Interpretability &amp; Validation" vertex="1">
