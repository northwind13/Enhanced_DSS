        <mxCell id="TdOF3XnuV87c0GEvnkGq-13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=13;" value="&lt;b&gt;External Inputs \(F_{in,k}\)&lt;/b&gt;&lt;br&gt;&lt;br&gt;\(U_{Meteo,k}\) : meteorology&lt;br&gt;\(U_{Geo,k}\) : topography&lt;br&gt;\(U_{Fuel,k}\) : fuel data&lt;br&gt;\(U_{Ign,k}\) : ignition injection&lt;br&gt;\(U_{DSS,k}\) : DSS intervention" vertex="1">
          <mxGeometry height="148" width="170" x="160" y="180" as="geometry" />
        </mxCell>
        <mxCell id="TdOF3XnuV87c0GEvnkGq-14" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;fontSize=13;" value="&lt;b&gt;Current State \(S_k(x,y)\)&lt;/b&gt;&lt;br&gt;&lt;br&gt;\(B_k\) : burning status&lt;br&gt;\(F_{load,k}\) : fuel mass&lt;br&gt;\(I_k\) : fire intensity&lt;br&gt;\(\tau_k\) : ignition time" vertex="1">
          <mxGeometry height="165" width="170" x="160" y="389" as="geometry" />
        </mxCell>
        <mxCell id="TdOF3XnuV87c0GEvnkGq-15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;dashed=1;align=center;verticalAlign=top;spacing=10;fontSize=14;" value="&lt;b&gt;State Transition Operator \(\Phi\bigl(S_k(x,y),\,F_{in,k}\bigr)\)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#777777&quot;&gt;hybrid, deterministic transition&lt;/font&gt;" vertex="1">
          <mxGeometry height="620" width="410" x="370" y="100" as="geometry" />
        </mxCell>
        <mxCell id="TdOF3XnuV87c0GEvnkGq-16" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=center;verticalAlign=middle;spacing=6;fontSize=14;" value="&lt;b&gt;(1) Burning Status Evolution&lt;/b&gt;&lt;br&gt;&lt;br&gt;\(B_{k+1}(x,y)=\max\{\,B^{\mathrm{pers}}_{k+1},\,B^{\mathrm{prop}}_{k+1},\,I_{Ign,k}\,\}\)&lt;br&gt;&lt;font color=&quot;#777777&quot;&gt;persistence &amp;#8853; propagation &amp;#8853; injection&lt;/font&gt;" vertex="1">
          <mxGeometry height="105" width="370" x="390" y="160" as="geometry" />
        </mxCell>
        <mxCell id="TdOF3XnuV87c0GEvnkGq-17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;spacing=6;fontSize=14;" value="&lt;b&gt;(2) Fuel Mass Evolution&lt;/b&gt;&lt;br&gt;&lt;br&gt;\(F_{load,k+1}(x,y)=\max\{0,\;F_{load,k}-F_{burn,k}-F_{red,k}\}\)&lt;br&gt;&lt;font color=&quot;#777777&quot;&gt;available fuel &amp;#8722; combustion &amp;#8722; suppression&lt;/font&gt;" vertex="1">
          <mxGeometry height="105" width="370" x="390" y="285" as="geometry" />
        </mxCell>
        <mxCell id="TdOF3XnuV87c0GEvnkGq-18" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;spacing=6;fontSize=14;" value="&lt;b&gt;(3) Fire Intensity Evolution&lt;/b&gt;&lt;br&gt;&lt;br&gt;\(I_{k+1}(x,y)=B_{k+1}\cdot\tanh\bigl(\beta\tilde{F}_k+\gamma_{W}\tilde{W}_k+\gamma_{S}\tilde{S}\bigr)\)&lt;br&gt;&lt;font color=&quot;#777777&quot;&gt;bounded nonlinear combination of fuel, wind, slope&lt;/font&gt;" vertex="1">
          <mxGeometry height="105" width="370" x="390" y="410" as="geometry" />
        </mxCell>
        <mxCell id="TdOF3XnuV87c0GEvnkGq-19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=middle;spacing=6;fontSize=14;" value="&lt;b&gt;(4) Ignition Time Evolution&lt;/b&gt;&lt;br&gt;&lt;br&gt;\(\tau_{k+1}(x,y)=\begin{cases}0 &amp; \text{new ignition}\\[2pt]\tau_{k}+\Delta t &amp; \text{active burning}\\[2pt]0 &amp; \text{extinction}\end{cases}\)" vertex="1">
          <mxGeometry height="150" width="370" x="390" y="535" as="geometry" />
        </mxCell>
        <mxCell id="TdOF3XnuV87c0GEvnkGq-20" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=8;fontSize=14;" value="&lt;b&gt;Next State \(S_{k+1}(x,y)\)&lt;/b&gt;&lt;br&gt;&lt;br&gt;\(B_{k+1},\;F_{load,k+1}\)&lt;br&gt;\(I_{k+1},\;\tau_{k+1}\)&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#777777&quot;&gt;\(S_{k+1}=\Phi(S_k,\,F_{in,k})\)&lt;/font&gt;" vertex="1">
          <mxGeometry height="190" width="160" x="820" y="315" as="geometry" />
        </mxCell>
        <mxCell id="TdOF3XnuV87c0GEvnkGq-21" edge="1" parent="1" source="TdOF3XnuV87c0GEvnkGq-14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#6c8ebf;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.6;" target="TdOF3XnuV87c0GEvnkGq-15">
