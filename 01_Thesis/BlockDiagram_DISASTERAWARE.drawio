    <mxGraphModel dx="1779" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="f512-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1A9850;strokeColor=none;fontSize=13;align=center;verticalAlign=middle;spacingTop=-4;" value="&lt;b style=&quot;font-size: 23px; color: #FFFFFF&quot;&gt;0&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #FFFFFF&quot;&gt;mean 15&lt;/span&gt;" vertex="1">
