        </mxCell>
        <mxCell id="SJcJ09xJZXgUBLT_JLGA-6" parent="1" style="whiteSpace=wrap;html=1;fillColor=#DEEBF7;strokeColor=#2E75B6;fontSize=12;align=center;spacingTop=4;spacingBottom=4;" value="Adaptive interventions over an open decision space; antecedent space reduced; decision-cycle-compatible latency" vertex="1">
