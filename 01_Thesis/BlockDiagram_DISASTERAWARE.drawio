          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lNcD1cP_uyyhPGFS0B8A-16" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#888888;strokeWidth=1;fontSize=11;verticalAlign=middle;align=left;spacing=8;" value="&lt;b&gt;Arrow legend&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#006600;&quot;&gt;━━ strong&lt;/span&gt;: \(g_{\text{dir}} \to 1\)&lt;br&gt;&amp;nbsp;&amp;nbsp;(aligned with wind)&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#ff8800;&quot;&gt;━ moderate&lt;/span&gt;: \(g_{\text{dir}} \in (0,1)\)&lt;br&gt;&amp;nbsp;&amp;nbsp;(oblique)&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#999999;&quot;&gt;- - blocked&lt;/span&gt;: \(g_{\text{dir}} = 0\)&lt;br&gt;&amp;nbsp;&amp;nbsp;(against wind)" vertex="1">
          <mxGeometry height="200" width="220" x="222" y="133" as="geometry" />
        </mxCell>
        <mxCell id="lNcD1cP_uyyhPGFS0B8A-17" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;verticalAlign=top;fontSize=12;dashed=0;" value="" vertex="1">
          <mxGeometry height="280" width="671" x="222" y="386" as="geometry" />
        </mxCell>
        <mxCell id="lNcD1cP_uyyhPGFS0B8A-18" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;" value="&lt;b&gt;Propagation influence accumulated at target cell \((x,y)\)&lt;/b&gt;" vertex="1">
          <mxGeometry height="25" width="658" x="232" y="396" as="geometry" />
        </mxCell>
        <mxCell id="lNcD1cP_uyyhPGFS0B8A-19" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;" value="&lt;b&gt;Directional weighting factor (Rothermel-type anisotropy)&lt;/b&gt;" vertex="1">
          <mxGeometry height="22" width="662" x="232" y="496" as="geometry" />
        </mxCell>
        <mxCell id="lNcD1cP_uyyhPGFS0B8A-20" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#444444;" value="where \(\theta_{(i,j)\to(x,y)}\) is the geometric direction from burning neighbor \((i,j)\) to target \((x,y)\), and \(W_{\text{wd},k}(i,j)\) is the local wind direction." vertex="1">
          <mxGeometry height="25" width="660" x="232" y="576" as="geometry" />
        </mxCell>
        <mxCell id="lNcD1cP_uyyhPGFS0B8A-21" parent="1" style="text;whiteSpace=wrap;html=1;" value="\(\Psi_k(x,y) \;=\; \dfrac{1}{8}\displaystyle\sum_{(i,j)\in \mathcal{N}_8(x,y)} B_k(i,j)\cdot R_{\text{spread},k}(i,j)\cdot g_{\text{dir},k}^{(i,j)\to(x,y)} \qquad \)" vertex="1">
          <mxGeometry height="51" width="457" x="375" y="419" as="geometry" />
        </mxCell>
        <mxCell id="lNcD1cP_uyyhPGFS0B8A-22" parent="1" style="text;whiteSpace=wrap;html=1;" value="\(g_{\text{dir},k}^{(i,j)\to(x,y)} \;=\; \max\!\bigl\{\,0,\; \cos\!\bigl(W_{\text{wd},k}(i,j) - \theta_{(i,j)\to(x,y)}\bigr)\bigr\} \qquad \)" vertex="1">
          <mxGeometry height="51" width="419" x="361" y="518" as="geometry" />
        </mxCell>
        <mxCell id="lNcD1cP_uyyhPGFS0B8A-23" parent="1" style="text;whiteSpace=wrap;html=1;" value="Interpretation: propagation influence from \((i,j)\) is weighted by the cosine of the angle between wind direction and the geometric connection vector. Upwind neighbors contribute fully \((g_{\text{dir}}\to 1)\); perpendicular and downwind neighbors are attenuated or zeroed by the \(\max\{0,\cdot\}\) clipping, producing anisotropic spread aligned with prevailing wind." vertex="1">
          <mxGeometry height="54" width="660" x="227" y="608" as="geometry" />
        </mxCell>
        <mxCell id="lNcD1cP_uyyhPGFS0B8A-24" parent="1" style="text;whiteSpace=wrap;html=1;" value="Filled red cells indicate burning neighbors \((B_k=1)\); arrow thickness reflects directional weight \(g_{\text{dir}}\in[0,1]\)" vertex="1">
          <mxGeometry height="30" width="643" x="222" y="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
