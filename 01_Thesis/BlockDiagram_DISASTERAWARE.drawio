        </mxCell>
        <mxCell id="SJcJ09xJZXgUBLT_JLGA-9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7030A0;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;arcSize=8;" value="H3  Simulated Feasibility Under Uncertainty" vertex="1">
