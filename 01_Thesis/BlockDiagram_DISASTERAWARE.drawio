        <mxCell id="ebRH9_izZCovWzlnWHGh-16" edge="1" parent="1" source="ebRH9_izZCovWzlnWHGh-6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;strokeWidth=1.3;fontSize=10;fontColor=#1F4E79;" target="ebRH9_izZCovWzlnWHGh-7" value="shares scale offensive families">
