        <mxCell id="SJcJ09xJZXgUBLT_JLGA-1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F3864;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;arcSize=10;" value="RESEARCH QUESTION" vertex="1">
          <mxGeometry height="24" width="720" x="230" y="199" as="geometry" />
        </mxCell>
        <mxCell id="SJcJ09xJZXgUBLT_JLGA-2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9E2F3;strokeColor=#1F3864;fontSize=12;fontStyle=2;arcSize=10;align=left;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;" value="How can a wildfire DSS generate adaptive intervention guidance over an open decision space, expose the reasoning behind every recommendation derived from incomplete observations together with the sensitivity of the closed-loop outputs, and demonstrate the pipeline end to end against a strictly separated simulation core, under distributed, decision-cycle-compatible latency constraints, with analytically stated and empirically evaluated pipeline properties?" vertex="1">
          <mxGeometry height="68" width="720" x="230" y="223" as="geometry" />
        </mxCell>
        <mxCell id="SJcJ09xJZXgUBLT_JLGA-3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#375623;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;arcSize=10;" value="MAIN HYPOTHESIS" vertex="1">
          <mxGeometry height="24" width="720" x="230" y="316" as="geometry" />
        </mxCell>
        <mxCell id="SJcJ09xJZXgUBLT_JLGA-4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#375623;fontSize=13;fontStyle=2;arcSize=10;align=left;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;" value="A hierarchically distributed DSS built on concept-driven fuzzy reasoning, equipped with adaptive and generative rule evolution behind a satisficing verification gate, intrinsic rule-level traceability with quantified sensitivity, and a strictly separated simulation core, addresses the three identified structural gaps and states its pipeline properties analytically while evaluating them empirically." vertex="1">
          <mxGeometry height="65" width="720" x="230" y="340" as="geometry" />
        </mxCell>
        <mxCell id="SJcJ09xJZXgUBLT_JLGA-5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E75B6;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;arcSize=8;" value="H1  Scalability &amp; Adaptability" vertex="1">
