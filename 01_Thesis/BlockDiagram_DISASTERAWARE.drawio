  <diagram id="KhOOvvZTiyKz7Psqo140" name="Figure 4.12 Example of local decisions, global coordination, and the fail-safe">
    <mxGraphModel dx="754" dy="892" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="D066kyzz_8KezAGM8SY4-27" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C0392B;fontSize=12;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" value="&lt;b&gt;Agent 1&lt;/b&gt; sees an intense fire close to a settlement&lt;br&gt;(medium fire threat and very high asset exposure).&lt;br&gt;&lt;i&gt;Operational priority \(p_1 = 0.82\).&lt;/i&gt;" vertex="1">
          <mxGeometry height="54" width="300" x="50" y="36" as="geometry" />
        </mxCell>
        <mxCell id="D066kyzz_8KezAGM8SY4-28" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF6E6;strokeColor=#C65911;fontSize=12;align=left;verticalAlign=middle;" value="&lt;b&gt;Agent 2&lt;/b&gt; sees a fire of similar intensity in empty forest&lt;br&gt;(medium fire threat, low asset exposure).&lt;br&gt;&lt;i&gt;Operational priority \(p_2 = 0.24\).&lt;/i&gt;" vertex="1">
          <mxGeometry height="54" width="300" x="50" y="120" as="geometry" />
        </mxCell>
        <mxCell id="D066kyzz_8KezAGM8SY4-29" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#7A7A7A;fontSize=12;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;" value="&lt;b&gt;Agent 3&lt;/b&gt; is quiet (low fire threat).&lt;br&gt;&lt;i&gt;Operational priority \(p_3 = 0.12\).&lt;/i&gt;" vertex="1">
          <mxGeometry height="54" width="300" x="50" y="210" as="geometry" />
        </mxCell>
        <mxCell id="D066kyzz_8KezAGM8SY4-30" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E9F7;strokeColor=#6A1B9A;fontSize=12;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontStyle=0;" value="Global DSS ranks \(p_1 &amp;gt; p_2 &amp;gt; p_3\) and makes Agent 1 the focus.&lt;div&gt;&lt;br&gt;Shares \(\sigma_1 = 1.00\), \(\sigma_2 = 0.65\), \(\sigma_3 = 0.57\); budget concentrated on Agent 1.&lt;/div&gt;&lt;div&gt;&lt;br&gt;It returns to each agent the allocation, the normalized priority weights, and the acceptance thresholds.&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="360" x="450" y="90" as="geometry" />
        </mxCell>
        <mxCell id="D066kyzz_8KezAGM8SY4-31" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF0FA;strokeColor=#4472C4;fontSize=12;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;" value="Final orders after the shares scale the candidates:&#xa;Agent 1 fields full suppression effort and resource deployment,&#xa;Agent 2 a lighter suppression effort on a smaller budget,&#xa;Agent 3 protection and monitoring at \(\sigma_3 = 0.57\)." vertex="1">
          <mxGeometry height="64" width="360" x="450" y="270" as="geometry" />
        </mxCell>
        <mxCell id="D066kyzz_8KezAGM8SY4-32" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF6EE;strokeColor=#2E7D32;fontSize=12;align=center;verticalAlign=middle;" value="&lt;b&gt;Decision cycle \(k\).&amp;nbsp;&lt;/b&gt;&lt;div&gt;No-harm check: plan \(\hat J = 0.22\) is below no action \(\hat J_0 = 0.35\),&amp;nbsp;so the plan is applied and the orders are fielded.&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="520" x="370" y="400" as="geometry" />
        </mxCell>
        <mxCell id="D066kyzz_8KezAGM8SY4-33" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C0392B;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" value="&lt;b&gt;A later decision cycle.&amp;nbsp;&lt;/b&gt;&lt;div&gt;The wind reverses, so the same plan is now forecast at \(\hat J = 0.40\),&amp;nbsp;above no action \(\hat J_0 = 0.31\).&lt;/div&gt;&lt;div&gt;The no-harm guard withholds the offensive orders;&amp;nbsp;only Agent 1 public warning and evacuation are fielded, and the offensive posture resumes next cycle.&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="680" x="290" y="510" as="geometry" />
        </mxCell>
        <mxCell id="D066kyzz_8KezAGM8SY4-34" edge="1" parent="1" source="D066kyzz_8KezAGM8SY4-27" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;strokeWidth=1.3;fontSize=10;fontColor=#1F4E79;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" target="D066kyzz_8KezAGM8SY4-30" value="priority, request,&amp;nbsp;&lt;div&gt;confidence&lt;/div&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="D066kyzz_8KezAGM8SY4-35" edge="1" parent="1" source="D066kyzz_8KezAGM8SY4-28" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;strokeWidth=1.3;fontSize=10;fontColor=#1F4E79;" target="D066kyzz_8KezAGM8SY4-30" value="priority, request,&amp;nbsp;&lt;div&gt;confidence&lt;/div&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="D066kyzz_8KezAGM8SY4-36" edge="1" parent="1" source="D066kyzz_8KezAGM8SY4-29" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;strokeWidth=1.3;fontSize=10;fontColor=#1F4E79;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" target="D066kyzz_8KezAGM8SY4-30" value="priority, request,&amp;nbsp;&lt;div&gt;confidence&lt;/div&gt;">
          <mxGeometry relative="1" x="0.0018" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="D066kyzz_8KezAGM8SY4-37" edge="1" parent="1" source="D066kyzz_8KezAGM8SY4-30" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;strokeWidth=1.3;fontSize=10;fontColor=#1F4E79;" target="D066kyzz_8KezAGM8SY4-31" value="shares scale the candidates">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="D066kyzz_8KezAGM8SY4-38" edge="1" parent="1" source="D066kyzz_8KezAGM8SY4-31" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;strokeWidth=1.3;fontSize=10;fontColor=#1F4E79;" target="D066kyzz_8KezAGM8SY4-32" value="shadow forecast">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="D066kyzz_8KezAGM8SY4-39" edge="1" parent="1" source="D066kyzz_8KezAGM8SY4-32" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;strokeWidth=1.3;fontSize=10;fontColor=#1F4E79;;dashed=1" target="D066kyzz_8KezAGM8SY4-33" value="later cycle, conditions change">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="jwZVE05a1n1PSdnAtXqr-5" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FBFBEA;strokeColor=#7A7A7A;dashed=1;fontSize=14;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" value="Attention threshold \(= 0.35\).&lt;div&gt;&lt;br&gt;A region is attended with \(\sigma = 1.00\) when \(p_i \ge 0.35\,p_{max}\); otherwise it is monitored with&amp;nbsp;&lt;/div&gt;&lt;div&gt;\(\sigma = 0.5 + 0.5\,(p_i/p_{max})\).&lt;/div&gt;&lt;div&gt;&lt;br&gt;The share scales only the monitored region; the focus and its budget follow the priority ranking.&lt;/div&gt;" vertex="1">
          <mxGeometry height="190" width="280" x="50" y="290" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
