        <mxCell id="o0GtjoNhhDa_-aW8Pc8q-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=20;fontStyle=1" value="......." vertex="1">
