        <mxCell id="ebRH9_izZCovWzlnWHGh-10" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C0392B;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" value="The offensive orders are withheld this cycle.&#xa;No capacity is fielded and no response cost is paid,&#xa;while the life-safety orders (evacuation and public warning) still stand." vertex="1">
          <mxGeometry height="84" width="291" x="520" y="560" as="geometry" />
        </mxCell>
        <mxCell id="ebRH9_izZCovWzlnWHGh-14" edge="1" parent="1" source="ebRH9_izZCovWzlnWHGh-4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;strokeWidth=1.3;fontSize=10;fontColor=#1F4E79;entryX=0.75;entryY=0;entryDx=0;entryDy=0;exitX=0.25;exitY=1;exitDx=0;exitDy=0;" target="ebRH9_izZCovWzlnWHGh-6" value="operational priority,&amp;nbsp;&lt;div&gt;resource request, confidence&lt;/div&gt;">
