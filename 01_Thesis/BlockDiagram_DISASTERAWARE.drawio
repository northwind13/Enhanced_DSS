          <mxGeometry height="84" width="132" x="210" y="224" as="geometry" />
        </mxCell>
        <mxCell id="f512-3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1A9850;strokeColor=none;fontSize=13;align=center;verticalAlign=middle;spacingTop=-4;" value="&lt;b style=&quot;font-size: 23px; color: #FFFFFF&quot;&gt;0&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #FFFFFF&quot;&gt;mean 15&lt;/span&gt;" vertex="1">
