          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eJwHMeqF2bI5ILnGksuy-18" edge="1" parent="1" source="eJwHMeqF2bI5ILnGksuy-8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;strokeWidth=1.3;fontSize=14;fontColor=#1F4E79;" target="eJwHMeqF2bI5ILnGksuy-9" value="send to Global DSS">
