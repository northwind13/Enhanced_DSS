  <diagram id="ctFP5iIh_U_Ki4w1DfzC" name="Figure 4.11 Global coordination and the no-harm fail-safe">
    <mxGraphModel dx="515" dy="892" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ebRH9_izZCovWzlnWHGh-2" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF0FA;strokeColor=#4472C4;fontSize=12;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;" value="Local DSS 1 forms the candidate \(U_{DSS,k}^{1}\) for its region" vertex="1">
          <mxGeometry height="60" width="220" x="179" y="85" as="geometry" />
        </mxCell>
        <mxCell id="ebRH9_izZCovWzlnWHGh-4" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF0FA;strokeColor=#4472C4;fontSize=12;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;" value="Local DSS N forms the candidate \(U_{DSS,k}^{N}\) for its region" vertex="1">
