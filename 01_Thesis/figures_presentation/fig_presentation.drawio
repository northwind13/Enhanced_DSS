<diagram name="inference_choice" id="inference_choice"><mxGraphModel dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="700" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Mamdani or Takagi–Sugeno — the same rules, two different answers" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Calibri;fontSize=20;fontColor=#2B2B2B;fontStyle=1;horizontal=1;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1140" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&amp;#945;&lt;sub&gt;r&lt;/sub&gt; = min&lt;sub&gt;n &amp;#8712; ant(r)&lt;/sub&gt; &amp;#956;&lt;sub&gt;A&lt;sub&gt;r,n&lt;/sub&gt;&lt;/sub&gt;( a&lt;sup&gt;eff,i&lt;/sup&gt;&lt;sub&gt;n,k&lt;/sub&gt; )&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;( 0.10 , 0.30 , 0.80 , 0.50 , 0.15 )" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Calibri;fontSize=13;fontColor=#6E6E6E;fontStyle=0;horizontal=1;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1140" height="22" as="geometry"/></mxCell><mxCell id="c4" value="the five rules and their firing strengths are identical on both sides — only the consequent differs" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Calibri;fontSize=12;fontColor=#6E6E6E;fontStyle=2;horizontal=1;" vertex="1" parent="1"><mxGeometry x="30" y="72" width="1140" height="20" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontColor=#2B2B2B;fontFamily=Calibri;fontSize=12;align=center;arcSize=4;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="30" y="104" width="560" height="430" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDFD;strokeColor=#C8102E;fontColor=#2B2B2B;fontFamily=Calibri;fontSize=12;align=center;arcSize=4;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="610" y="104" width="560" height="430" as="geometry"/></mxCell><mxCell id="c7" value="MAMDANI &amp;#8212; the answer is a shape" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Calibri;fontSize=14;fontColor=#6E6E6E;fontStyle=1;horizontal=1;" vertex="1" parent="1"><mxGeometry x="48" y="116" width="530" height="24" as="geometry"/></mxCell><mxCell id="c8" value="consequent: &amp;#8220;… THEN U&lt;sub&gt;DSS&lt;/sub&gt; is B&lt;sub&gt;r&lt;/sub&gt;&amp;#8221; &amp;#8212; clip at &amp;#945;&lt;sub&gt;r&lt;/sub&gt;, aggregate, defuzzify" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Calibri;fontSize=11;fontColor=#6E6E6E;fontStyle=2;horizontal=1;" vertex="1" parent="1"><mxGeometry x="48" y="140" width="530" height="20" as="geometry"/></mxCell><mxCell id="c9" value="" style="shape=image;html=1;image=data:image/svg+xml,;imageAspect=0;" vertex="1" parent="1"><mxGeometry x="48" y="166" width="524" height="242" as="geometry"/></mxCell><mxCell id="c10" value="&amp;#956;&lt;sub&gt;agg&lt;/sub&gt;(u) = max&lt;sub&gt;r&lt;/sub&gt; min( &amp;#945;&lt;sub&gt;r&lt;/sub&gt; , &amp;#956;&lt;sub&gt;B&lt;sub&gt;r&lt;/sub&gt;&lt;/sub&gt;(u) )" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Calibri;fontSize=13;fontColor=#2B2B2B;fontStyle=0;horizontal=1;" vertex="1" parent="1"><mxGeometry x="48" y="418" width="524" height="22" as="geometry"/></mxCell><mxCell id="c11" value="u* = &amp;#8747; u &amp;#956;&lt;sub&gt;agg&lt;/sub&gt;(u) du &amp;nbsp;/&amp;nbsp; &amp;#8747; &amp;#956;&lt;sub&gt;agg&lt;/sub&gt;(u) du" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Calibri;fontSize=15;fontColor=#2B2B2B;fontStyle=0;horizontal=1;" vertex="1" parent="1"><mxGeometry x="48" y="446" width="524" height="32" as="geometry"/></mxCell><mxCell id="c12" value="the five rules melt into one area — who ordered what is lost" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Calibri;fontSize=11;fontColor=#6E6E6E;fontStyle=2;horizontal=1;" vertex="1" parent="1"><mxGeometry x="48" y="492" width="524" height="22" as="geometry"/></mxCell><mxCell id="c13" value="ZERO-ORDER TAKAGI&amp;#8211;SUGENO &amp;#8212; the answer is a number" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Calibri;fontSize=14;fontColor=#C8102E;fontStyle=1;horizontal=1;" vertex="1" parent="1"><mxGeometry x="628" y="116" width="530" height="24" as="geometry"/></mxCell><mxCell id="c14" value="consequent: &amp;#8220;… THEN U&lt;sub&gt;DSS&lt;/sub&gt; = v&lt;sub&gt;r,m&lt;/sub&gt;&amp;#8221; &amp;#8212; no output set, no integral" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Calibri;fontSize=11;fontColor=#C8102E;fontStyle=2;horizontal=1;" vertex="1" parent="1"><mxGeometry x="628" y="140" width="530" height="20" as="geometry"/></mxCell><mxCell id="c15" value="" style="shape=image;html=1;image=data:image/svg+xml,;imageAspect=0;" vertex="1" parent="1"><mxGeometry x="628" y="166" width="524" height="242" as="geometry"/></mxCell><mxCell id="c16" value="v&lt;sub&gt;r,m&lt;/sub&gt; : one number per rule, per action family" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Calibri;fontSize=13;fontColor=#2B2B2B;fontStyle=0;horizontal=1;" vertex="1" parent="1"><mxGeometry x="628" y="418" width="524" height="22" as="geometry"/></mxCell><mxCell id="c17" value="u&lt;sup&gt;i&lt;/sup&gt;&lt;sub&gt;m,k&lt;/sub&gt; = &amp;#931;&lt;sub&gt;r&lt;/sub&gt; &amp;#945;&lt;sub&gt;r&lt;/sub&gt; v&lt;sub&gt;r,m&lt;/sub&gt; &amp;nbsp;/&amp;nbsp; max( 1 , &amp;#931;&lt;sub&gt;r&lt;/sub&gt; &amp;#945;&lt;sub&gt;r&lt;/sub&gt; )" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Calibri;fontSize=15;fontColor=#2B2B2B;fontStyle=0;horizontal=1;" vertex="1" parent="1"><mxGeometry x="628" y="446" width="524" height="32" as="geometry"/></mxCell><mxCell id="c18" value="each rule keeps its own share of the order — traceable by construction" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Calibri;fontSize=11;fontColor=#C8102E;fontStyle=2;horizontal=1;" vertex="1" parent="1"><mxGeometry x="628" y="492" width="524" height="22" as="geometry"/></mxCell><mxCell id="c19" value="Both return about the same number &amp;#8212; the difference is not the number, it is what survives the computation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEFEF;strokeColor=#CCCCCC;fontColor=#2B2B2B;fontFamily=Calibri;fontSize=15;align=center;arcSize=8;strokeWidth=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="556" width="1140" height="54" as="geometry"/></mxCell><mxCell id="c20" value="the 0.53 / 0.54 gap is the max-aggregation absorbing the overlapped area of the weak rules — not an accuracy difference" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Calibri;fontSize=11;fontColor=#6E6E6E;fontStyle=2;horizontal=1;" vertex="1" parent="1"><mxGeometry x="30" y="620" width="1140" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="inference_demands" id="inference_demands"><mxGraphModel dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="700" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Why zero-order Takagi–Sugeno" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Calibri;fontSize=20;fontColor=#2B2B2B;fontStyle=1;horizontal=1;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1140" height="30" as="geometry"/></mxCell><mxCell id="c3" value="three things the framework demands of the inference — and only one family gives all three" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Calibri;fontSize=13;fontColor=#6E6E6E;fontStyle=2;horizontal=1;" vertex="1" parent="1"><mxGeometry x="30" y="52" width="1140" height="22" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=none;fontColor=#2B2B2B;fontFamily=Calibri;fontSize=12;align=center;arcSize=4;strokeWidth=0;" vertex="1" parent="1"><mxGeometry x="610" y="112" width="250" height="440" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5D3D9;strokeColor=none;fontColor=#2B2B2B;fontFamily=Calibri;fontSize=12;align=center;arcSize=4;strokeWidth=0;" vertex="1" parent="1"><mxGeometry x="880" y="112" width="290" height="440" as="geometry"/></mxCell><mxCell id="c6" value="WHAT THE FRAMEWORK DEMANDS" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Calibri;fontSize=12;fontColor=#2B2B2B;fontStyle=1;horizontal=1;" vertex="1" parent="1"><mxGeometry x="30" y="88" width="560" height="20" as="geometry"/></mxCell><mxCell id="c7" value="MAMDANI" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Calibri;fontSize=13;fontColor=#6E6E6E;fontStyle=1;horizontal=1;" vertex="1" parent="1"><mxGeometry x="620" y="88" width="240" height="20" as="geometry"/></mxCell><mxCell id="c8" value="ZERO-ORDER TAKAGI–SUGENO" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Calibri;fontSize=13;fontColor=#C8102E;fontStyle=1;horizontal=1;" vertex="1" parent="1"><mxGeometry x="880" y="88" width="290" height="20" as="geometry"/></mxCell><mxCell id="c9" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEFEF;strokeColor=none;fontColor=#2B2B2B;fontFamily=Calibri;fontSize=12;align=center;arcSize=5;strokeWidth=0;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="560" height="128" as="geometry"/></mxCell><mxCell id="c10" value="1" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Calibri;fontSize=22;fontColor=#C8102E;fontStyle=1;horizontal=1;" vertex="1" parent="1"><mxGeometry x="46" y="136" width="34" height="30" as="geometry"/></mxCell><mxCell id="c11" value="The order IS a number" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Calibri;fontSize=15;fontColor=#2B2B2B;fontStyle=1;horizontal=1;" vertex="1" parent="1"><mxGeometry x="86" y="136" width="490" height="30" as="geometry"/></mxCell><mxCell id="c12" value="U&lt;sup&gt;i&lt;/sup&gt;&lt;sub&gt;DSS,k&lt;/sub&gt; &amp;#8712; [0,1] &amp;#8212; suppression effort, evacuation urgency" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Calibri;fontSize=12;fontColor=#6E6E6E;fontStyle=0;horizontal=1;" vertex="1" parent="1"><mxGeometry x="86" y="194" width="490" height="26" as="geometry"/></mxCell><mxCell id="c13" value="" style="shape=image;html=1;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PGcgc3Ryb2tlPSIjNkU2RTZFIiBzdHJva2Utd2lkdGg9IjMiIHN0cm9rZS1saW5lY2FwPSJyb3VuZCI+PGxpbmUgeDE9IjUiIHkxPSI1IiB4Mj0iMTkiIHkyPSIxOSIvPjxsaW5lIHgxPSIxOSIgeTE9IjUiIHgyPSI1IiB5Mj0iMTkiLz48L2c+PC9zdmc+;imageAspect=0;" vertex="1" parent="1"><mxGeometry x="620" y="160" width="26" height="26" as="geometry"/></mxCell><mxCell id="c14" value="a shape first,&lt;br&gt;a number only&lt;br&gt;after an integral" style="text;html=1;align=left;verticalAlign=top;fontFamily=Calibri;fontSize=12;fontColor=#6E6E6E;fontStyle=0;horizontal=1;" vertex="1" parent="1"><mxGeometry x="660" y="142" width="200" height="84" as="geometry"/></mxCell><mxCell id="c15" value="" style="shape=image;html=1;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PHBvbHlsaW5lIHBvaW50cz0iNCwxMyA5LjUsMTkgMjAsNSIgZmlsbD0ibm9uZSIgc3Ryb2tlPSIjQzgxMDJFIiBzdHJva2Utd2lkdGg9IjMuMiIgc3Ryb2tlLWxpbmVjYXA9InJvdW5kIiBzdHJva2UtbGluZWpvaW49InJvdW5kIi8+PC9zdmc+;imageAspect=0;" vertex="1" parent="1"><mxGeometry x="898" y="160" width="26" height="26" as="geometry"/></mxCell><mxCell id="c16" value="the number is&lt;br&gt;the consequent —&lt;br&gt;nothing to undo" style="text;html=1;align=left;verticalAlign=top;fontFamily=Calibri;fontSize=12;fontColor=#2B2B2B;fontStyle=0;horizontal=1;" vertex="1" parent="1"><mxGeometry x="938" y="142" width="220" height="8