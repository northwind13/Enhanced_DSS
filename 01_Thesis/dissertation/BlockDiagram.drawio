        <mxCell id="TZkqeqn1FpQU0tbcJpcB-2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#888888;" value="Spatial Wildfire Environment — Ω ⊂ ℝ²   (all variables defined over (x, y) ∈ Ω)" vertex="1">
