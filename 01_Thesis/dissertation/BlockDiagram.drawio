        </mxCell>
        <mxCell id="TZkqeqn1FpQU0tbcJpcB-3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;strokeWidth=2;fontSize=13;fontColor=#085041;" value="&lt;b&gt;Wildfire system state&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(0, 0, 0); font-size: 12px; text-align: left;&quot;&gt;\(S_{k}(x,y)\)&lt;/span&gt;" vertex="1">
