        <mxCell id="DQ0i8efqef6YgGJB3xNo-8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=1.5;fontSize=11;verticalAlign=middle;" value="&lt;b&gt;(1) Burning Status Evolution&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;B&lt;sub&gt;k+1&lt;/sub&gt;&lt;/i&gt;(&lt;i&gt;x,y&lt;/i&gt;) = max(&lt;i&gt;B&lt;sub&gt;k+1&lt;/sub&gt;&lt;sup&gt;pers&lt;/sup&gt;&lt;/i&gt;,  &lt;i&gt;B&lt;sub&gt;k+1&lt;/sub&gt;&lt;sup&gt;prop&lt;/sup&gt;&lt;/i&gt;,  &lt;i&gt;I&lt;sub&gt;Ign,k&lt;/sub&gt;&lt;/i&gt;)&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px;&quot;&gt;persistence  &amp;oplus;  propagation  &amp;oplus;  ignition&lt;/font&gt;" vertex="1">
