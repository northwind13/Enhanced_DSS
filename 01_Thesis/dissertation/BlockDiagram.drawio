        </mxCell>
        <mxCell id="Q63Zgnu5gNZlpXN7kska-4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#555555;strokeWidth=1.5;verticalAlign=top;fontSize=13;dashed=0;" value="&lt;b&gt;State Transition Operator \(\Phi\bigl(S_k(x,y),\, F_{\text{in},k}\bigr)\)&lt;/b&gt;" vertex="1">
          <mxGeometry height="315" width="500" x="240" y="1100" as="geometry" />
        </mxCell>
