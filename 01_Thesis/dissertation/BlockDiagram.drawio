        <mxCell id="ZVZXMdQOPStDrvNbhPyU-57" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;" value="&lt;b&gt;Proposition 5.2 — Constant Reduction Ratio&lt;/b&gt;" vertex="1">
          <mxGeometry height="22" width="750" x="210" y="588" as="geometry" />
        </mxCell>
        <mxCell id="ZVZXMdQOPStDrvNbhPyU-58" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#555555;" value="&lt;b&gt;Marginal scalability:&lt;/b&gt; each new intervention type adds only \(N_\mu^{N_{\text{concept}}} = 81\) rules under concept-mediated inference, compared to \(N_\mu^{N_{\text{feat}}} = 729\) rules under direct inference — a constant ninefold saving independent of \(M\)." vertex="1">
          <mxGeometry height="40" width="750" x="210" y="665" as="geometry" />
        </mxCell>
        <mxCell id="ZVZXMdQOPStDrvNbhPyU-59" parent="1" style="text;whiteSpace=wrap;html=1;" value="\(\kappa \;=\; \dfrac{|\mathcal{R}_{\text{direct}}|}{|\mathcal{R}_{\text{concept}}|} \;=\; \dfrac{M\cdot N_\mu^{N_{\text{feat}}}}{M\cdot N_\mu^{N_{\text{concept}}}} \;=\; N_\mu^{\,N_{\text{feat}} - N_{\text{concept}}} \;=\; 3^{\,6-4} \;=\; 9 \qquad (\text{for all } M \geq 1)\)" vertex="1">
          <mxGeometry height="65" width="550" x="330.9966666666668" y="608.0033333333336" as="geometry" />
        </mxCell>
      </root>
