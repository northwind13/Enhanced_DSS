          <mxGeometry height="70" width="420" x="310" y="420" as="geometry" />
        </mxCell>
        <mxCell id="J7JNwbcTlPQnGHuabK18-18" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="&lt;b&gt;Step 4 — Decision quality evaluation&lt;/b&gt;&lt;br&gt;`Q_{DSS,k} = \sum_{j=1}^{4} w_{j} \cdot q_{j,k} \geq \eta_{k}`" vertex="1">
          <mxGeometry height="70" width="360" x="340" y="520" as="geometry" />
        </mxCell>
        <mxCell id="J7JNwbcTlPQnGHuabK18-19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="&lt;b&gt;Step 5 — Decision acceptance / fail-safe&lt;/b&gt;&lt;br&gt;\(U_{DSS,k}^{final}(x,y) = \zeta_{k} \cdot U_{DSS,k}(x,y) + (1-\zeta_{k}) \cdot U_{safe,k}(x,y)\)&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;`\zeta_{k} = Q_{DSS,k} / (\eta_{k} + \varepsilon)`&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="420" x="310" y="620" as="geometry" />
        </mxCell>
        <mxCell id="J7JNwbcTlPQnGHuabK18-20" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="&lt;b&gt;Step 6 — Feedback injection&lt;/b&gt;&lt;br&gt;`\mathcal{F}_{in,k} \leftarrow U_{DSS,k}^{final}(x,y)`&lt;br&gt;`S_{k+1}(x,y) = \Phi\left(S_{k}(x,y), \mathcal{F}_{in,k}\right)`" vertex="1">
          <mxGeometry height="80" width="360" x="340" y="730" as="geometry" />
        </mxCell>
