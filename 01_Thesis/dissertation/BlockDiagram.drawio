        </mxCell>
        <mxCell id="TZkqeqn1FpQU0tbcJpcB-4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#185FA5;strokeWidth=2;fontSize=13;fontColor=#0C447C;" value="&lt;b&gt;Observable information&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(0, 0, 0); font-size: 12px; text-align: left;&quot;&gt;\(O_k(x,y)=h(S_{k}(x,y),\epsilon_k)\)&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#185FA5;&quot;&gt;ε&lt;sub&gt;k&lt;/sub&gt;: partial observability noise&lt;/i&gt;" vertex="1">
          <mxGeometry height="90" width="230" x="320" y="72" as="geometry" />
        </mxCell>
        <mxCell id="TZkqeqn1FpQU0tbcJpcB-6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;strokeWidth=2;fontSize=13;fontColor=#3C3489;" value="&lt;b&gt;Local decision generation&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0); font-size: 12px; text-align: left;&quot;&gt;\(U^i_{DSS,k} (x,y) =\pi_{DSS}(O^i_k(x,y), \mathcal F^i_{DSS,k})\)&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="95" width="330" x="670" y="70" as="geometry" />
        </mxCell>
        <mxCell id="TZkqeqn1FpQU0tbcJpcB-7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAECE7;strokeColor=#993C1D;strokeWidth=2;fontSize=13;fontColor=#712B13;" value="&lt;b&gt;Global coordination&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(0, 0, 0); font-size: 12px; text-align: left;&quot;&gt;\(U_{DSS,k} (x,y) =\mathcal A_{DSS}(U^i_{DSS,k}(x,y))^{i=N}_{i=1}\)&lt;/span&gt;" vertex="1">
          <mxGeometry height="85" width="330" x="670" y="221" as="geometry" />
        </mxCell>
        <mxCell id="TZkqeqn1FpQU0tbcJpcB-8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;strokeWidth=2;fontSize=13;fontColor=#633806;" value="&lt;b&gt;Decision evaluation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 12px; text-align: left;&quot;&gt;\(Q_{DSS,k} = f_{eval}(S_k, O_k, \mathcal F_{DSS,k}, U_{DSS,k}(x,y))\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size: 12px; text-align: left;&quot;&gt;\(Q_{DSS,k} ≥ \eta_k\)&lt;/span&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="330" x="670" y="351" as="geometry" />
        </mxCell>
        <mxCell id="TZkqeqn1FpQU0tbcJpcB-9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;strokeWidth=2;fontSize=13;fontColor=#3C3489;" value="&lt;b&gt;Decision-related inputs&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0); font-size: 12px; text-align: left;&quot;&gt;\(U_{DSS,k}(x,y) ⊂ F_{in,k}\)&lt;/span&gt;&lt;br style=&quot;color: rgb(0, 0, 0); font-size: 12px; text-align: left;&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0); font-size: 12px; text-align: left;&quot;&gt;\(U_{DSS,k} ∈ \mathcal U_{DSS}(O_k(x,y), \mathcal F_{DSS,k})\)&lt;/span&gt;&lt;/div&gt;" vertex="1">
