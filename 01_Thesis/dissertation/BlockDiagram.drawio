        </mxCell>
        <mxCell id="CAt5ispbLHXvSITkjoxK-20" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;" value="&lt;b&gt;Directional weighting factor (Rothermel-type anisotropy)&lt;/b&gt;" vertex="1">
          <mxGeometry height="22" width="662" x="102" y="486" as="geometry" />
        </mxCell>
        <mxCell id="CAt5ispbLHXvSITkjoxK-21" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#444444;" value="where \(\theta_{(i,j)\to(x,y)}\) is the geometric direction from burning neighbor \((i,j)\) to target \((x,y)\), and \(W_{\text{wd},k}(i,j)\) is the local wind direction." vertex="1">
          <mxGeometry height="25" width="660" x="102" y="566" as="geometry" />
        </mxCell>
        <mxCell id="CAt5ispbLHXvSITkjoxK-22" parent="1" style="text;whiteSpace=wrap;html=1;" value="\(\Psi_k(x,y) \;=\; \dfrac{1}{8}\displaystyle\sum_{(i,j)\in \mathcal{N}_8(x,y)} B_k(i,j)\cdot R_{\text{spread},k}(i,j)\cdot g_{\text{dir},k}^{(i,j)\to(x,y)} \qquad \text{Eq. (43)}\)" vertex="1">
          <mxGeometry height="51" width="457" x="245" y="409" as="geometry" />
        </mxCell>
        <mxCell id="CAt5ispbLHXvSITkjoxK-23" parent="1" style="text;whiteSpace=wrap;html=1;" value="\(g_{\text{dir},k}^{(i,j)\to(x,y)} \;=\; \max\!\bigl\{\,0,\; \cos\!\bigl(W_{\text{wd},k}(i,j) - \theta_{(i,j)\to(x,y)}\bigr)\bigr\} \qquad \text{Eq. (45)}\)" vertex="1">
          <mxGeometry height="51" width="419" x="231" y="508" as="geometry" />
        </mxCell>
        <mxCell id="CAt5ispbLHXvSITkjoxK-24" parent="1" style="text;whiteSpace=wrap;html=1;" value="Interpretation: propagation influence from \((i,j)\) is weighted by the cosine of the angle between wind direction and the geometric connection vector. Upwind neighbors contribute fully \((g_{\text{dir}}\to 1)\); perpendicular and downwind neighbors are attenuated or zeroed by the \(\max\{0,\cdot\}\) clipping, producing anisotropic spread aligned with prevailing wind." vertex="1">
          <mxGeometry height="54" width="660" x="97" y="598" as="geometry" />
        </mxCell>
        <mxCell id="CAt5ispbLHXvSITkjoxK-25" parent="1" style="text;whiteSpace=wrap;html=1;" value="Filled red cells indicate burning neighbors \((B_k=1)\); arrow thickness reflects directional weight \(g_{\text{dir}}\in[0,1]\)" vertex="1">
          <mxGeometry height="30" width="643" x="83" y="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
