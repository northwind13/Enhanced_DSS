        <mxCell id="TZkqeqn1FpQU0tbcJpcB-6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;strokeWidth=2;fontSize=13;fontColor=#3C3489;" value="&lt;b&gt;Local decision generation&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0); font-size: 12px; text-align: left;&quot;&gt;\(U^i_{DSS,k} (x,y) =\pi_{DSS}(O^i_k(x,y), \mathcal F^i_{DSS,k})\)&lt;/span&gt;&lt;/div&gt;" vertex="1">
