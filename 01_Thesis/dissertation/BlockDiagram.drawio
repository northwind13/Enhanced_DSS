        </mxCell>
        <mxCell id="DQ0i8efqef6YgGJB3xNo-9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;fontSize=11;verticalAlign=middle;" value="&lt;b&gt;(2) Fuel Mass Evolution&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;F&lt;sub&gt;load,k+1&lt;/sub&gt;&lt;/i&gt;(&lt;i&gt;x,y&lt;/i&gt;) = max(0,  &lt;i&gt;F&lt;sub&gt;load,k&lt;/sub&gt;&lt;/i&gt; &amp;minus; &lt;i&gt;F&lt;sub&gt;burn,k&lt;/sub&gt;&lt;/i&gt; &amp;minus; &lt;i&gt;F&lt;sub&gt;red,k&lt;/sub&gt;&lt;/i&gt;)&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px;&quot;&gt;current fuel &amp;minus; combustion &amp;minus; suppression&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="400" x="539" y="300" as="geometry" />
        </mxCell>
        <mxCell id="DQ0i8efqef6YgGJB3xNo-10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F57F17;strokeWidth=1.5;fontSize=11;verticalAlign=middle;" value="&lt;b&gt;(3) Fire Intensity Evolution&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;I&lt;sub&gt;k+1&lt;/sub&gt;&lt;/i&gt;(&lt;i&gt;x,y&lt;/i&gt;) = &lt;i&gt;B&lt;sub&gt;k+1&lt;/sub&gt;&lt;/i&gt; &amp;middot; tanh(&amp;beta; &lt;i&gt;F&lt;/i&gt; + &amp;gamma;&lt;sub&gt;W&lt;/sub&gt;&lt;i&gt;W&lt;/i&gt; + &amp;gamma;&lt;sub&gt;S&lt;/sub&gt;&lt;i&gt;S&lt;/i&gt;)&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px;&quot;&gt;bounded nonlinear combination of fuel, wind, slope&lt;/font&gt;" vertex="1">
