          <mxGeometry x="430" y="380" width="220" height="120" as="geometry"/>
        </mxCell>

        <!-- Time Controller -->
        <mxCell id="time" value="Time Controller (ΔT Engine)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
