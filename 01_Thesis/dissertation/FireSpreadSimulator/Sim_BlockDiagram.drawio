<mxfile host="app.diagrams.net">
  <diagram name="Wildfire Simulation Architecture">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- External Data -->
        <mxCell id="external" value="External Data Sources&#10;- Meteorology API&#10;- DEM&#10;- OSM&#10;- Satellite&#10;- IoT Sensors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="600" y="20" width="350" height="120" as="geometry"/>
        </mxCell>

        <!-- Observer Module -->
        <mxCell id="observer" value="Observer Module&#10;- Weather Update&#10;- Sensor Fusion&#10;- Data Assimilation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
