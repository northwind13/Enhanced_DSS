        <!-- Hybrid Fire Model -->
        <mxCell id="firemodel" value="Hybrid Fire Spread Model&#10;- Deterministic Layer&#10;- Stochastic Layer&#10;- ROS + Spotting" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="690" y="480" width="250" height="120" as="geometry"/>
