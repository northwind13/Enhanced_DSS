        <!-- Action Executor -->
        <mxCell id="executor" value="Action Executor&#10;- Fuel Reduction&#10;- Water Drop&#10;- Fireline&#10;- Backburn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
